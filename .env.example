# PivotPHP Skeleton Environment
APP_NAME="PivotPHP Skeleton API"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# OpenAPI/Swagger
OPENAPI_ENABLED=true
SWAGGER_UI_ENABLED=true

# Performance
CACHE_ROUTES=false
OPTIMIZE_RESPONSES=true

# Security  
CORS_ENABLED=true
RATE_LIMITING=false
SECURE_HEADERS=false

# Logging
LOG_LEVEL=debug