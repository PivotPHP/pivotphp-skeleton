# Copied to .env by `composer create-project`. Real environment variables take precedence.
APP_NAME="PivotPHP Skeleton API"
APP_ENV=development

# Debug responses expose exception messages and stack traces. Never enable in production.
APP_DEBUG=false

# Comma-separated list of origins allowed by CORS (e.g. http://localhost:5173). Empty = disabled.
CORS_ALLOWED_ORIGINS=
