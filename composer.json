{
    "name": "pivotphp/skeleton",
    "description": "Skeleton project for PivotPHP v2.2.0 - The evolutionary PHP microframework",
    "keywords": ["framework", "api", "rest", "express", "skeleton", "project-template"],
    "license": "MIT",
    "type": "project",
    "authors": [
        {
            "name": "PivotPHP Team",
            "email": "team@pivotphp.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.1",
        "pivotphp/core": "^2.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "post-create-project-cmd": [
            "@php post-create-project.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "extra": {
        "pivotphp": {
            "version": "2.2.0",
            "edition": "Route Syntax & DX Edition"
        }
    }
}