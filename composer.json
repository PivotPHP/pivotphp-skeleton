{
    "name": "pivotphp/skeleton",
    "description": "Project template for PivotPHP 4 — Express.js-style PHP API on PSR-7/PSR-15",
    "keywords": [
        "pivotphp",
        "framework",
        "api",
        "rest",
        "express",
        "psr-7",
        "psr-15",
        "skeleton",
        "project-template"
    ],
    "license": "MIT",
    "type": "project",
    "authors": [
        {
            "name": "PivotPHP Team",
            "email": "team@pivotphp.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.1",
        "pivotphp/core": "^4.1.1"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^10.5.62|^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public",
        "test": "phpunit",
        "post-create-project-cmd": [
            "@php post-create-project.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
